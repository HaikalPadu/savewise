# Base URL used for every API request.
#
# Leave it as /api to use the Vite dev proxy (see vite.config.js), which
# forwards /api to the Laravel dev server on http://127.0.0.1:8000.
#
# Set it to a full URL if the backend runs somewhere else, for example:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=/api
